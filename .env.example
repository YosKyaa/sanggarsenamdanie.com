# Supabase (Project Settings → API). Leave empty to preview with bundled content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never prefix with NEXT_PUBLIC_): lets admins create accounts,
# reset passwords and delete users from /admin/users. Supabase → Project
# Settings → API Keys → service_role. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com

# Everything else — WhatsApp number, address, founder profile, photos, FAQ,
# stats — is edited in /admin (Pengaturan Situs and the Halaman menu).
# Without Supabase the site shows the defaults from src/lib/content/defaults.ts.
